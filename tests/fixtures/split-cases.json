{
  "description": "Shared split fixtures for the Rust engine (cargo test) and the JS engine (npm test). Defaults per case: useRegex=false, trimParts=false, keepEmptyLines=true. 'expected' applies to both engines; a case with a known engine difference uses 'expectedRust' + 'expectedJs' and must explain it in 'divergence' ('resolved' documents a former divergence). Rows are the data lines of the shared line model (Paket 6, tests/fixtures/line-endings-cases.json): LF, CRLF and CR are line breaks, a trailing line break adds no row, an empty text has no rows. Every expected result is column-major: expected[column][row].",
  "cases": [
    {
      "name": "b1: column created in a later row is padded for earlier rows",
      "input": "A,B\nC,D,E\nF,G",
      "delimiter": ",",
      "expected": [["A", "C", "F"], ["B", "D", "G"], ["", "E", ""]]
    },
    {
      "name": "b1: new columns only in the last row",
      "input": "A\nB\nC,D,E",
      "delimiter": ",",
      "expected": [["A", "B", "C"], ["", "", "D"], ["", "", "E"]]
    },
    {
      "name": "b1: column count grows row by row",
      "input": "a\nb,c\nd,e,f",
      "delimiter": ",",
      "expected": [["a", "b", "d"], ["", "c", "e"], ["", "", "f"]]
    },
    {
      "name": "different column counts, widest row first",
      "input": "A,B,C\nD\nE,F",
      "delimiter": ",",
      "expected": [["A", "D", "E"], ["B", "", "F"], ["C", "", ""]]
    },
    {
      "name": "missing values in the last row (browser e2e input)",
      "input": "a_b_c\nd_e_f\ng_h",
      "delimiter": "_",
      "expected": [["a", "d", "g"], ["b", "e", "h"], ["c", "f", ""]]
    },
    {
      "name": "empty split field keeps its column",
      "input": "A,,C",
      "delimiter": ",",
      "expected": [["A"], [""], ["C"]]
    },
    {
      "name": "empty split fields in several rows",
      "input": "A,,C\n,B,\n,,",
      "delimiter": ",",
      "expected": [["A", "", ""], ["", "B", ""], ["C", "", ""]]
    },
    {
      "name": "only delimiters",
      "input": ",,",
      "delimiter": ",",
      "expected": [[""], [""], [""]]
    },
    {
      "name": "delimiter at start and end of a line",
      "input": ",A,\nB",
      "delimiter": ",",
      "expected": [["", "B"], ["A", ""], ["", ""]]
    },
    {
      "name": "text without delimiter gives one column",
      "input": "Hello World\nFoo",
      "delimiter": ",",
      "expected": [["Hello World", "Foo"]]
    },
    {
      "name": "multi-character delimiter",
      "input": "a::b::c\nd::e",
      "delimiter": "::",
      "expected": [["a", "d"], ["b", "e"], ["c", ""]]
    },
    {
      "name": "regex metacharacters are literal without useRegex",
      "input": "a.b|c\nd.e",
      "delimiter": ".",
      "expected": [["a", "d"], ["b|c", "e"]]
    },
    {
      "name": "empty input, keep empty lines",
      "input": "",
      "delimiter": ",",
      "expected": [],
      "resolved": "Paket 6: was a divergence (JS split('\\n') yielded one empty row); an empty text has no data lines in both engines."
    },
    {
      "name": "empty input, skip empty lines",
      "input": "",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": []
    },
    {
      "name": "empty input line is kept as a row",
      "input": "A,B\n\nC,D",
      "delimiter": ",",
      "expected": [["A", "", "C"], ["B", "", "D"]]
    },
    {
      "name": "empty input line is skipped",
      "input": "A,B\n\nC,D",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "several empty input lines are skipped",
      "input": "\n\nA,B\n\n\nC,D",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "kept empty line before a new column is padded",
      "input": "A\n\nB,C",
      "delimiter": ",",
      "expected": [["A", "", "B"], ["", "", "C"]]
    },
    {
      "name": "skipped empty line before a new column",
      "input": "A\n\nB,C",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", "B"], ["", "C"]]
    },
    {
      "name": "skipping empty lines keeps empty split fields",
      "input": "A,,C\n\n,,",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", ""], ["", ""], ["C", ""]]
    },
    {
      "name": "whitespace-only line is not an empty line",
      "input": "A,B\n   \nC,D",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", "   ", "C"], ["B", "", "D"]]
    },
    {
      "name": "whitespace-only line is not an empty line, even with trimParts",
      "input": "A,B\n \t \nC,D",
      "delimiter": ",",
      "keepEmptyLines": false,
      "trimParts": true,
      "expected": [["A", "", "C"], ["B", "", "D"]]
    },
    {
      "name": "leading and trailing empty lines, keep",
      "input": "\nA,B\n\n",
      "delimiter": ",",
      "expected": [["", "A", ""], ["", "B", ""]],
      "resolved": "Paket 6: was a divergence (JS split('\\n') added a row for the trailing newline); the final '\\n' terminates the empty last line."
    },
    {
      "name": "leading and trailing empty lines, skip",
      "input": "\nA,B\n\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A"], ["B"]]
    },
    {
      "name": "trailing LF, keep empty lines",
      "input": "A,B\nC,D\n",
      "delimiter": ",",
      "expected": [["A", "C"], ["B", "D"]],
      "resolved": "Paket 6: was a divergence (JS split('\\n') added a row for the trailing newline); a trailing newline adds no row."
    },
    {
      "name": "trailing LF, skip empty lines",
      "input": "A,B\nC,D\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "CRLF without trailing newline, trimParts off",
      "input": "A,B\r\nC,D",
      "delimiter": ",",
      "expected": [["A", "C"], ["B", "D"]],
      "resolved": "Paket 6: was a divergence (JS split('\\n') left '\\r' in the last part); the line terminator is not part of the line in both engines."
    },
    {
      "name": "CRLF without trailing newline, trimParts on",
      "input": "A,B\r\nC,D",
      "delimiter": ",",
      "trimParts": true,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "CRLF with trailing newline, trimParts on",
      "input": "A,B\r\nC,D\r\n",
      "delimiter": ",",
      "trimParts": true,
      "expected": [["A", "C"], ["B", "D"]],
      "resolved": "Paket 6: was a divergence (JS split('\\n') added a row for the trailing '\\r\\n'); a trailing newline adds no row."
    },
    {
      "name": "CRLF empty line is kept",
      "input": "A,B\r\n\r\nC,D",
      "delimiter": ",",
      "trimParts": true,
      "expected": [["A", "", "C"], ["B", "", "D"]]
    },
    {
      "name": "CRLF empty line is skipped",
      "input": "A,B\r\n\r\nC,D",
      "delimiter": ",",
      "trimParts": true,
      "keepEmptyLines": false,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "CRLF trailing newline, skip empty lines",
      "input": "A,B\r\nC,D\r\n",
      "delimiter": ",",
      "trimParts": true,
      "keepEmptyLines": false,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "unicode: umlauts, emojis and CJK",
      "input": "Grüße,Straße\n😀,🎉,ß\n日本,語",
      "delimiter": ",",
      "expected": [["Grüße", "😀", "日本"], ["Straße", "🎉", "語"], ["", "ß", ""]]
    },
    {
      "name": "unicode delimiter",
      "input": "a→b→c\nä→ö",
      "delimiter": "→",
      "expected": [["a", "ä"], ["b", "ö"], ["c", ""]]
    },
    {
      "name": "emoji delimiter",
      "input": "x😀y\n😀z",
      "delimiter": "😀",
      "expected": [["x", ""], ["y", "z"]]
    },
    {
      "name": "trimParts off keeps spaces",
      "input": " A , B \n C,D ",
      "delimiter": ",",
      "expected": [[" A ", " C"], [" B ", "D "]]
    },
    {
      "name": "trimParts on removes spaces",
      "input": " A , B \n C,D ",
      "delimiter": ",",
      "trimParts": true,
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "trimParts on removes tabs and no-break spaces",
      "input": "\tÄ , ü\t",
      "delimiter": ",",
      "trimParts": true,
      "expected": [["Ä"], ["ü"]]
    },
    {
      "name": "regex: digits as delimiter",
      "input": "a1b22c",
      "delimiter": "\\d+",
      "useRegex": true,
      "expected": [["a"], ["b"], ["c"]]
    },
    {
      "name": "regex: whitespace as delimiter",
      "input": "a  b\tc\nd e",
      "delimiter": "\\s+",
      "useRegex": true,
      "expected": [["a", "d"], ["b", "e"], ["c", ""]]
    },
    {
      "name": "regex: character class with later new column (b1)",
      "input": "a;b\nc;d|e",
      "delimiter": "[;|]",
      "useRegex": true,
      "expected": [["a", "c"], ["b", "d"], ["", "e"]]
    },
    {
      "name": "regex: alternation of multi-character delimiters",
      "input": "a::b--c",
      "delimiter": "::|--",
      "useRegex": true,
      "expected": [["a"], ["b"], ["c"]]
    },
    {
      "name": "regex: match at start and end of the line",
      "input": ";a;",
      "delimiter": ";",
      "useRegex": true,
      "expected": [[""], ["a"], [""]]
    },
    {
      "name": "regex: trimParts with regex",
      "input": " a ; b ",
      "delimiter": ";",
      "useRegex": true,
      "trimParts": true,
      "expected": [["a"], ["b"]]
    },
    {
      "name": "regex: unicode text with ASCII class",
      "input": "😀1🎉2ü",
      "delimiter": "\\d",
      "useRegex": true,
      "expected": [["😀"], ["🎉"], ["ü"]]
    },
    {
      "name": "regex: positive lookbehind",
      "input": "1,a,2,b",
      "delimiter": "(?<=\\d),",
      "useRegex": true,
      "expected": [["1"], ["a,2"], ["b"]]
    },
    {
      "name": "regex: negative lookbehind (escaped delimiter)",
      "input": "a\\,b,c\nd,e\\,f",
      "delimiter": "(?<!\\\\),",
      "useRegex": true,
      "expected": [["a\\,b", "d"], ["c", "e\\,f"]]
    },
    {
      "name": "regex: positive lookahead (zero-width split)",
      "input": "aXbYc",
      "delimiter": "(?=[XY])",
      "useRegex": true,
      "expected": [["a"], ["Xb"], ["Yc"]]
    },
    {
      "name": "regex: lookbehind and lookahead combined",
      "input": "1.000,50\n2.5",
      "delimiter": "(?<=\\d)\\.(?=\\d{3})",
      "useRegex": true,
      "expected": [["1", "2.5"], ["000,50", ""]]
    },
    {
      "name": "regex: empty lines are skipped in regex mode",
      "input": "a1b\n\nc",
      "delimiter": "\\d",
      "useRegex": true,
      "keepEmptyLines": false,
      "expected": [["a", "c"], ["b", ""]]
    },
    {
      "name": "regex: capture group",
      "input": "a,b",
      "delimiter": "(,)",
      "useRegex": true,
      "expectedRust": [["a"], ["b"]],
      "expectedJs": [["a"], [","], ["b"]],
      "divergence": "Capture groups: fancy-regex split drops captured text, JS String.prototype.split inserts every capture as an extra part (= extra column)."
    },
    {
      "name": "regex: unicode word class",
      "input": "Grüße Welt",
      "delimiter": "\\W+",
      "useRegex": true,
      "expectedRust": [["Grüße"], ["Welt"]],
      "expectedJs": [["Gr"], ["e"], ["Welt"]],
      "divergence": "Unicode classes: \\w/\\W/\\d/\\s are Unicode-aware in fancy-regex, JS RegExp without the 'u' flag treats \\w as [A-Za-z0-9_]."
    },
    {
      "name": "empty plain delimiter",
      "input": "abc",
      "delimiter": "",
      "expectedRust": [[""], ["a"], ["b"], ["c"], [""]],
      "expectedJs": [["a"], ["b"], ["c"]],
      "divergence": "Empty delimiter: Rust str::split(\"\") yields an empty part before and after the characters, JS split('') yields only the characters."
    },
    {
      "name": "regex: non-capturing group keeps the columns",
      "input": "a,b;c",
      "delimiter": "(?:,|;)",
      "useRegex": true,
      "expected": [["a"], ["b"], ["c"]]
    },
    {
      "name": "regex: emoji as delimiter",
      "input": "a😀b😀c\nd",
      "delimiter": "😀",
      "useRegex": true,
      "expected": [["a", "d"], ["b", ""], ["c", ""]]
    },
    {
      "name": "regex: named capture group",
      "input": "a,b;c",
      "delimiter": "(?<sep>[,;])",
      "useRegex": true,
      "expectedRust": [["a"], ["b"], ["c"]],
      "expectedJs": [["a"], [","], ["b"], [";"], ["c"]],
      "divergence": "Capture groups (also named ones): fancy-regex split drops captured text, JS String.prototype.split inserts every capture as an extra part (= extra column)."
    },
    {
      "name": "regex: capture group that does not participate in the match",
      "input": "a;b",
      "delimiter": "(,)|;",
      "useRegex": true,
      "expectedRust": [["a"], ["b"]],
      "expectedJs": [["a"], [""], ["b"]],
      "divergence": "JS split inserts a non-participating capture as undefined (stored as an empty column value); fancy-regex split ignores captures."
    },
    {
      "name": "regex: zero-width match at the start of the line",
      "input": "abc",
      "delimiter": "(?=a)",
      "useRegex": true,
      "expectedRust": [[""], ["abc"]],
      "expectedJs": [["abc"]],
      "divergence": "Empty matches: fancy-regex split yields an empty part before an empty match at position 0, JS split ignores an empty match at the start of the string."
    },
    {
      "name": "regex: word boundary as delimiter",
      "input": "a b",
      "delimiter": "\\b",
      "useRegex": true,
      "expectedRust": [[""], ["a"], [" "], ["b"], [""]],
      "expectedJs": [["a"], [" "], ["b"]],
      "divergence": "Empty matches at the start and end of the line: fancy-regex split yields empty parts there, JS split does not."
    },
    {
      "name": "regex: Unicode digit as delimiter",
      "input": "a١b",
      "delimiter": "\\d",
      "useRegex": true,
      "expectedRust": [["a"], ["b"]],
      "expectedJs": [["a١b"]],
      "divergence": "Unicode classes: \\d matches Unicode decimal digits in fancy-regex, only [0-9] in JS."
    },
    {
      "name": "CRLF with trailing newline, trimParts off",
      "input": "A,B\r\nC,D\r\n",
      "delimiter": ",",
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "CR line endings",
      "input": "A,B\rC,D\r",
      "delimiter": ",",
      "expected": [["A", "C"], ["B", "D"]]
    },
    {
      "name": "mixed line endings",
      "input": "A,B\r\nC,D\nE,F\rG",
      "delimiter": ",",
      "expected": [["A", "C", "E", "G"], ["B", "D", "F", ""]]
    },
    {
      "name": "one empty line with terminator, keep",
      "input": "\n",
      "delimiter": ",",
      "expected": [[""]]
    },
    {
      "name": "one empty line with terminator, skip",
      "input": "\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": []
    },
    {
      "name": "several empty lines, keep",
      "input": "\n\n",
      "delimiter": ",",
      "expected": [["", ""]]
    },
    {
      "name": "several trailing newlines, keep",
      "input": "A,B\n\n\n",
      "delimiter": ",",
      "expected": [["A", "", ""], ["B", "", ""]]
    },
    {
      "name": "several trailing newlines, skip",
      "input": "A,B\n\n\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A"], ["B"]]
    },
    {
      "name": "CRLF several trailing newlines, keep",
      "input": "A,B\r\n\r\n",
      "delimiter": ",",
      "expected": [["A", ""], ["B", ""]]
    },
    {
      "name": "CRLF leading empty lines, keep",
      "input": "\r\n\r\nA,B",
      "delimiter": ",",
      "expected": [["", "", "A"], ["", "", "B"]]
    },
    {
      "name": "CRLF empty split fields are kept when empty lines are skipped",
      "input": "A,,C\r\n,,\r\n\r\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", ""], ["", ""], ["C", ""]]
    },
    {
      "name": "CRLF different column counts with trailing newline",
      "input": "A\r\nB,C\r\n",
      "delimiter": ",",
      "expected": [["A", "B"], ["", "C"]]
    },
    {
      "name": "CRLF whitespace-only line is not empty",
      "input": "A,B\r\n \r\nC,D\r\n",
      "delimiter": ",",
      "keepEmptyLines": false,
      "expected": [["A", " ", "C"], ["B", "", "D"]]
    },
    {
      "name": "unicode with CRLF and trailing newline",
      "input": "Grüße,😀\r\nStraße,🎉\r\n",
      "delimiter": ",",
      "expected": [["Grüße", "Straße"], ["😀", "🎉"]]
    },
    {
      "name": "identical visible text, LF",
      "input": "a;b\nc;d\n",
      "delimiter": ";",
      "expected": [["a", "c"], ["b", "d"]]
    },
    {
      "name": "identical visible text, CRLF",
      "input": "a;b\r\nc;d\r\n",
      "delimiter": ";",
      "expected": [["a", "c"], ["b", "d"]]
    },
    {
      "name": "identical visible text, CR",
      "input": "a;b\rc;d\r",
      "delimiter": ";",
      "expected": [["a", "c"], ["b", "d"]]
    },
    {
      "name": "regex: $ anchors at the end of a CRLF line",
      "input": "a1\r\nb2\r\n",
      "delimiter": "\\d$",
      "useRegex": true,
      "expected": [["a", "b"], ["", ""]]
    },
    {
      "name": "regex: lookbehind on CRLF lines",
      "input": "1,a\r\n2,b\r\n",
      "delimiter": "(?<=\\d),",
      "useRegex": true,
      "expected": [["1", "2"], ["a", "b"]]
    }
  ]
}
