{
  "description": "Shared line-ending fixtures (Paket 6) for the Rust engine (cargo test) and the JS engine (npm test). Line breaks are LF, CRLF and CR, detected from the text itself (never from the operating system). A text is a list of data lines; a terminator after the last line is the trailing newline and is NOT an extra empty line. Newly generated result strings use the most frequent line ending of the input (tie: the one that occurs first; no line break: LF). A non-empty result keeps the trailing newline of the input; a result without data lines is ''. Line terminators are never part of a line's content, so regexes see the same line text in both engines. A case with a known engine difference uses 'expectedRust' + 'expectedJs' and must explain it in 'divergence'.",
  "lines": [
    { "name": "LF", "input": "A\nB", "lines": ["A", "B"], "lineEnding": "\n", "trailingNewline": false, "joined": "A\nB" },
    { "name": "LF with trailing newline", "input": "A\nB\n", "lines": ["A", "B"], "lineEnding": "\n", "trailingNewline": true, "joined": "A\nB\n" },
    { "name": "LF with two trailing newlines = empty last line", "input": "A\nB\n\n", "lines": ["A", "B", ""], "lineEnding": "\n", "trailingNewline": true, "joined": "A\nB\n\n" },
    { "name": "CRLF", "input": "A\r\nB", "lines": ["A", "B"], "lineEnding": "\r\n", "trailingNewline": false, "joined": "A\r\nB" },
    { "name": "CRLF with trailing newline", "input": "A\r\nB\r\n", "lines": ["A", "B"], "lineEnding": "\r\n", "trailingNewline": true, "joined": "A\r\nB\r\n" },
    { "name": "CRLF with several trailing newlines", "input": "A\r\n\r\n\r\n", "lines": ["A", "", ""], "lineEnding": "\r\n", "trailingNewline": true, "joined": "A\r\n\r\n\r\n" },
    { "name": "CR", "input": "A\rB", "lines": ["A", "B"], "lineEnding": "\r", "trailingNewline": false, "joined": "A\rB" },
    { "name": "CR with trailing newline", "input": "A\rB\r", "lines": ["A", "B"], "lineEnding": "\r", "trailingNewline": true, "joined": "A\rB\r" },
    { "name": "mixed: LF most frequent", "input": "A\r\nB\nC\nD", "lines": ["A", "B", "C", "D"], "lineEnding": "\n", "trailingNewline": false, "joined": "A\nB\nC\nD" },
    { "name": "mixed: CRLF most frequent", "input": "A\nB\r\nC\r\nD\r\n", "lines": ["A", "B", "C", "D"], "lineEnding": "\r\n", "trailingNewline": true, "joined": "A\r\nB\r\nC\r\nD\r\n" },
    { "name": "mixed: tie LF/CRLF, LF first", "input": "A\nB\r\nC", "lines": ["A", "B", "C"], "lineEnding": "\n", "trailingNewline": false, "joined": "A\nB\nC" },
    { "name": "mixed: tie CRLF/LF, CRLF first", "input": "A\r\nB\nC", "lines": ["A", "B", "C"], "lineEnding": "\r\n", "trailingNewline": false, "joined": "A\r\nB\r\nC" },
    { "name": "mixed: tie of all three, CR first", "input": "A\rB\nC\r\nD", "lines": ["A", "B", "C", "D"], "lineEnding": "\r", "trailingNewline": false, "joined": "A\rB\rC\rD" },
    { "name": "CR directly before CRLF is an empty line", "input": "A\r\r\nB", "lines": ["A", "", "B"], "lineEnding": "\r", "trailingNewline": false, "joined": "A\r\rB" },
    { "name": "LF followed by CR is not CRLF", "input": "A\n\rB", "lines": ["A", "", "B"], "lineEnding": "\n", "trailingNewline": false, "joined": "A\n\nB" },
    { "name": "no line break: LF fallback", "input": "A B", "lines": ["A B"], "lineEnding": "\n", "trailingNewline": false, "joined": "A B" },
    { "name": "empty text has no data lines", "input": "", "lines": [], "lineEnding": "\n", "trailingNewline": false, "joined": "" },
    { "name": "one empty line (LF)", "input": "\n", "lines": [""], "lineEnding": "\n", "trailingNewline": true, "joined": "\n" },
    { "name": "one empty line (CRLF)", "input": "\r\n", "lines": [""], "lineEnding": "\r\n", "trailingNewline": true, "joined": "\r\n" },
    { "name": "several empty lines", "input": "\n\n\n", "lines": ["", "", ""], "lineEnding": "\n", "trailingNewline": true, "joined": "\n\n\n" },
    { "name": "leading empty lines", "input": "\n\nA", "lines": ["", "", "A"], "lineEnding": "\n", "trailingNewline": false, "joined": "\n\nA" },
    { "name": "whitespace-only lines are data lines", "input": " \r\n\t\r\n", "lines": [" ", "\t"], "lineEnding": "\r\n", "trailingNewline": true, "joined": " \r\n\t\r\n" },
    { "name": "unicode: umlauts, emojis, CJK", "input": "Grüße\r\n😀 🎉\r\n日本", "lines": ["Grüße", "😀 🎉", "日本"], "lineEnding": "\r\n", "trailingNewline": false, "joined": "Grüße\r\n😀 🎉\r\n日本" },
    { "name": "other separators are not line breaks (U+2028, U+2029, NEL, VT, FF)", "input": "A\u2028B\u2029C\u0085D\u000bE\u000cF", "lines": ["A\u2028B\u2029C\u0085D\u000bE\u000cF"], "lineEnding": "\n", "trailingNewline": false, "joined": "A\u2028B\u2029C\u0085D\u000bE\u000cF" }
  ],
  "filter": [
    { "name": "CRLF result keeps CRLF", "input": "apple\r\nbanana\r\napricot", "pattern": "ap", "expected": "ap\r\nap" },
    { "name": "CRLF trailing newline is kept", "input": "apple\r\nbanana\r\napricot\r\n", "pattern": "ap", "expected": "ap\r\nap\r\n" },
    { "name": "LF trailing newline is kept", "input": "apple\nbanana\n", "pattern": "ple", "expected": "ple\n" },
    { "name": "split matches use the line ending of the input", "input": "banana\r\n", "pattern": "an", "expected": "an\r\nan\r\n" },
    { "name": "CR line endings", "input": "apple\rbanana\rapricot", "pattern": "ap", "expected": "ap\rap" },
    { "name": "$ anchors at the end of a CRLF line", "input": "ab\r\nb\r\nba", "pattern": "^b$", "expected": "b" },
    { "name": "$ anchors at the end of a CR line", "input": "ab\rb\rba", "pattern": "^b$", "expected": "b" },
    { "name": "no match: empty result without line break", "input": "apple\r\nbanana\r\n", "pattern": "zzz", "expected": "" },
    { "name": "only empty lines: empty result", "input": "\r\n\r\n", "pattern": "a", "expected": "" },
    { "name": "remove mode keeps format and trailing newline", "input": "a1\r\nb2\r\n", "pattern": "\\d", "mode": "remove", "expected": "a\r\nb\r\n" },
    { "name": "remove mode removing everything: empty result", "input": "a\nb\n", "pattern": ".*", "mode": "remove", "expected": "" },
    { "name": "mixed line endings: most frequent one for the result", "input": "x1\r\nx2\r\nx3\nx4", "pattern": "\\d", "expected": "1\r\n2\r\n3\r\n4" },
    { "name": "unicode with CRLF", "input": "Grüße 😀\r\nStraße 🎉\r\n", "pattern": "Grüße|🎉", "expected": "Grüße\r\n🎉\r\n" },
    { "name": "identical visible text, LF", "input": "one 1\ntwo 2\n", "pattern": "\\d", "expected": "1\n2\n" },
    { "name": "identical visible text, CRLF", "input": "one 1\r\ntwo 2\r\n", "pattern": "\\d", "expected": "1\r\n2\r\n" },
    { "name": "identical visible text, CR", "input": "one 1\rtwo 2\r", "pattern": "\\d", "expected": "1\r2\r" },
    { "name": "lookbehind on CRLF lines", "input": "$5\r\n$6", "pattern": "(?<=\\$)\\d", "expected": "5\r\n6" }
  ],
  "remove": [
    { "name": "CRLF: format and trailing newline are kept", "input": "a1\r\nb2\r\na3\r\n", "pattern": "a", "removeMode": "containing", "expected": { "text": "b2\r\n", "removedLines": 2 } },
    { "name": "trailing newline is not a line (containing)", "input": "x\ny\n", "pattern": "x", "removeMode": "containing", "expected": { "text": "y\n", "removedLines": 1 } },
    { "name": "trailing newline is not a line (notContaining)", "input": "x\ny\n", "pattern": "y", "removeMode": "notContaining", "expected": { "text": "y\n", "removedLines": 1 } },
    { "name": "removing all lines: empty string", "input": "a\r\nab\r\n", "pattern": "a", "removeMode": "containing", "expected": { "text": "", "removedLines": 2 } },
    { "name": "empty text: nothing removed", "input": "", "pattern": "a", "removeMode": "containing", "expected": { "text": "", "removedLines": 0 } },
    { "name": "empty lines are data lines", "input": "a\n\nb\n", "pattern": "b", "removeMode": "containing", "expected": { "text": "a\n\n", "removedLines": 1 } },
    { "name": "duplicates with CRLF", "input": "x\r\ny\r\nx\r\nz\r\n", "removeMode": "duplicates", "expected": { "text": "x\r\ny\r\nz\r\n", "removedLines": 1 } },
    { "name": "duplicates: same visible line with different line endings", "input": "x\r\nx\ny", "removeMode": "duplicates", "expected": { "text": "x\r\ny", "removedLines": 1 } },
    { "name": "duplicates: empty lines are compared too", "input": "a\n\nb\n\n", "removeMode": "duplicates", "expected": { "text": "a\n\nb\n", "removedLines": 1 } },
    { "name": "regex $ at the end of a CRLF line", "input": "a1\r\nb2\r\n", "pattern": "1$", "useRegex": true, "removeMode": "containing", "expected": { "text": "b2\r\n", "removedLines": 1 } },
    { "name": "regex lookbehind with CRLF", "input": "$5\r\n5\r\n", "pattern": "(?<=\\$)\\d", "useRegex": true, "removeMode": "containing", "expected": { "text": "5\r\n", "removedLines": 1 } },
    { "name": "CR line endings", "input": "a\rb\rc", "pattern": "b", "removeMode": "notContaining", "expected": { "text": "b", "removedLines": 2 } },
    { "name": "unicode duplicates with CRLF", "input": "Grüße\r\n😀\r\nGrüße\r\n", "removeMode": "duplicates", "expected": { "text": "Grüße\r\n😀\r\n", "removedLines": 1 } },
    {
      "name": "duplicates with trimParts: kept line",
      "input": " a\r\na\r\n",
      "removeMode": "duplicates",
      "trimParts": true,
      "expectedRust": { "text": "a\r\n", "removedLines": 1 },
      "expectedJs": { "text": " a\r\n", "removedLines": 1 },
      "divergence": "Existing behaviour (not a line-ending topic): with trimParts the Rust engine outputs the trimmed first occurrence, the JS engine the original line."
    }
  ],
  "combine": [
    { "name": "leading and trailing empty values keep their rows", "columns": [["", "A", ""]], "used": [{ "index": 0, "separator": "" }], "lineEnding": "\n", "trailingNewline": false, "expected": "\nA\n" },
    { "name": "trailing empty value with trailing newline", "columns": [["", "A", ""]], "used": [{ "index": 0, "separator": "" }], "lineEnding": "\n", "trailingNewline": true, "expected": "\nA\n\n" },
    { "name": "Part 3 + Part 1 keeps rows aligned (B1)", "columns": [["A", "C", "", "F"], ["B", "D", "", "G"], ["", "E", "", ""]], "used": [{ "index": 2, "separator": "" }, { "index": 0, "separator": ":" }], "lineEnding": "\n", "trailingNewline": false, "expected": ":A\nE:C\n:\n:F" },
    { "name": "CRLF with trailing newline", "columns": [["A", "C"], ["B", "D"]], "used": [{ "index": 1, "separator": "" }, { "index": 0, "separator": ":" }], "lineEnding": "\r\n", "trailingNewline": true, "expected": "B:A\r\nD:C\r\n" },
    { "name": "CR", "columns": [["A", "C"], ["B", "D"]], "used": [{ "index": 0, "separator": "" }, { "index": 1, "separator": ";" }], "lineEnding": "\r", "trailingNewline": false, "expected": "A;B\rC;D" },
    { "name": "separator per column", "columns": [["a"], ["b"], ["c"]], "used": [{ "index": 0, "separator": "" }, { "index": 1, "separator": "-" }, { "index": 2, "separator": "+" }], "lineEnding": "\n", "trailingNewline": true, "expected": "a-b+c\n" },
    { "name": "shorter (edited) column is padded, not shifted", "columns": [["a", "b", "c"], ["x"]], "used": [{ "index": 1, "separator": "" }, { "index": 0, "separator": "-" }], "lineEnding": "\r\n", "trailingNewline": false, "expected": "x-a\r\n-b\r\n-c" },
    { "name": "unicode values and separator", "columns": [["Grüße", "😀"], ["日本", "🎉"]], "used": [{ "index": 0, "separator": "" }, { "index": 1, "separator": "→" }], "lineEnding": "\r\n", "trailingNewline": true, "expected": "Grüße→日本\r\n😀→🎉\r\n" },
    { "name": "one empty value without trailing newline: empty string is a valid result", "columns": [[""], ["a"]], "used": [{ "index": 0, "separator": "" }], "lineEnding": "\n", "trailingNewline": false, "expected": "" },
    { "name": "all-empty column with empty separator leaves the text unchanged", "columns": [["a", "b"], ["", ""]], "used": [{ "index": 0, "separator": "" }, { "index": 1, "separator": "" }], "lineEnding": "\n", "trailingNewline": false, "expected": "a\nb" },
    { "name": "no columns: empty string", "columns": [], "used": [], "lineEnding": "\n", "trailingNewline": true, "expected": "" }
  ],
  "diff": [
    { "name": "CRLF vs LF: identical lines", "old": "A\r\nB\r\nC", "new": "A\nB\nC", "unchanged": ["A", "B", "C"], "changes": [] },
    { "name": "CR vs CRLF: identical lines", "old": "A\rB", "new": "A\r\nB", "unchanged": ["A", "B"], "changes": [] },
    { "name": "trailing newline on one side only: identical lines", "old": "A\nB\n", "new": "A\nB", "unchanged": ["A", "B"], "changes": [] },
    { "name": "empty lines are lines", "old": "A\n\nB", "new": "A\r\n\r\nB\r\n", "unchanged": ["", "A", "B"], "changes": [] },
    { "name": "real change in CRLF text", "old": "A\r\nB\r\n", "new": "A\r\nX\r\n", "unchanged": ["A"], "changes": ["added:X", "removed:B"] },
    { "name": "unicode CRLF vs LF", "old": "Grüße\r\n😀\r\n", "new": "Grüße\n😀\n", "unchanged": ["Grüße", "😀"], "changes": [] }
  ],
  "sort": [
    { "name": "CRLF: format and trailing newline are kept", "input": "b\r\nc\r\na\r\n", "method": "alphabetical", "expected": "a\r\nb\r\nc\r\n" },
    { "name": "LF without trailing newline", "input": "b\nc\na", "method": "alphabetical", "expected": "a\nb\nc" },
    { "name": "empty lines are dropped (existing behaviour), no extra line", "input": "b\n\na\n\n", "method": "alphabetical", "expected": "a\nb\n" },
    { "name": "CR, natural sort", "input": "2\r10\r1", "method": "natural", "expected": "1\r2\r10" },
    { "name": "mixed line endings: most frequent one", "input": "b\r\na\nc\r\n", "method": "alphabetical", "expected": "a\r\nb\r\nc\r\n" },
    { "name": "line length: CR is not part of the line", "input": "aa\r\na\r\naaa", "method": "lengthDesc", "expected": "aaa\r\naa\r\na" },
    { "name": "reverse with unicode", "input": "Ä\r\nZ\r\n😀\r\n", "method": "alphabeticalReverse", "expected": "Z\r\nÄ\r\n😀\r\n" },
    { "name": "only empty lines: empty result", "input": "\r\n\r\n", "method": "alphabetical", "expected": "" }
  ]
}
